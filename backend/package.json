    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.20.2",
    "prisma": "^6.9.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "esbuild@0.28.2": true,
